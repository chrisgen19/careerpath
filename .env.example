# PostgreSQL connection (Prisma + Better Auth)
DATABASE_URL="postgres://myuser:mypassword@localhost:5432/careerpath"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the Better Auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
